# Copiar como .env y completar sólo en el equipo del servidor.
# Nunca subir el archivo .env real.
FIREBASE_DATABASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=secrets/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=

MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
